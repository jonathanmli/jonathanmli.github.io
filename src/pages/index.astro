---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import SelfImprovementLoop from "../components/SelfImprovementLoop.astro";
import { publications, topicSlug } from "../lib/publications";

const featuredPublications = publications.filter((p) => p.featured);

interface NewsItem {
  date: string;
  /** Inline HTML for the item body. */
  html: string;
}

const link = (href: string, text: string) =>
  `<a class="link link-primary font-semibold" href="${href}">${text}</a>`;

// Newest first. The first RECENT_NEWS items show by default; the rest fold away.
const news: NewsItem[] = [
  { date: "Jul 2026", html: "🎉 One paper accepted to <strong>COLM 2026</strong>" },
  {
    date: "Jun 2026",
    html: `Joined ${link("https://www.microsoft.com/en-us/research/lab/microsoft-research-montreal/", "Microsoft Research")}, working with the ${link("https://microsoft.github.io/debug-gym/", "Froggy")} team on <strong>post-training coding agents</strong>`,
  },
  { date: "Apr 2026", html: "🎉 Two papers accepted to <strong>ICML 2026</strong>" },
  {
    date: "Mar 2026",
    html: `🎉 One paper accepted as <strong>Oral</strong> at the ${link("https://sites.google.com/view/iclr-2026-llmreasoning", "ICLR 2026 Logical Reasoning Workshop")}`,
  },
  { date: "Sep 2025", html: "🎉 One paper accepted to <strong>NeurIPS 2025</strong>" },
  {
    date: "May 2025",
    html: `Joined ${link("https://asari.ai/", "Asari.ai")}, working on <strong>code translation</strong> and <strong>GPU kernel optimization</strong>`,
  },
  { date: "Jan 2025", html: "🎉 Two papers accepted to <strong>ICLR 2025</strong>" },
  {
    date: "Jan 2025",
    html: `Joined ${link("https://www.cms.caltech.edu/", "Caltech")} as a <strong>Visiting Researcher</strong>, working with ${link("https://www.yisongyue.com/", "Yisong Yue")}`,
  },
  {
    date: "Oct 2024",
    html: `🎉 One paper accepted at the NeurIPS 2024 Workshop on ${link("https://language-gamification.github.io/", "LanGame")}`,
  },
  {
    date: "Jun 2024",
    html: `🎉 One paper accepted at the ICML 2024 Workshop on ${link("https://autorlworkshop.github.io/", "AutoRL")}`,
  },
  {
    date: "May 2024",
    html: `Joined ${link("https://www.nec-labs.com/", "NEC Laboratories America")} as a <strong>Research Intern</strong>, working with ${link("https://chengw07.github.io/", "Wei Cheng")}`,
  },
];

const RECENT_NEWS = 5;
const recentNews = news.slice(0, RECENT_NEWS);
const olderNews = news.slice(RECENT_NEWS);

const listBaseClasses = "space-y-3 text-base md:text-lg leading-relaxed";
const listItemWrapperClasses = "flex items-start gap-3";
const listItemContentClasses = "flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2";
const bulletClasses = "mt-2 h-2 w-2 shrink-0 bg-primary";
---

<BaseLayout sideBarActiveItemID="home">
  <section class="pb-6 mt-5">
    <p class="text-xl py-1">Hey there 👋</p>
    <h1 class="text-5xl font-bold">I'm Jonathan</h1>
    <p class="text-3xl py-3 font-bold">
      I build LLM agents that improve themselves through search and reinforcement learning.
    </p>
    <div class="py-2 space-y-4 text-lg">
      <p>
        My research asks how a model can propose its own problems, explore solutions with inference-time search, and
        learn from what it finds. Lately that has meant post-training coding agents.
      </p>
      <p>
        I am a Visiting Researcher at <a class="link link-primary" href="https://www.caltech.edu/">Caltech</a>,
        advised by <a class="link link-primary" href="https://www.yisongyue.com/">Yisong Yue</a>. I am pursuing a Ph.D. in
        Computer Science at <a class="link link-primary" href="https://www.rpi.edu/">Rensselaer Polytechnic Institute</a>, advised by
        <a class="link link-primary" href="https://sites.ecse.rpi.edu/~paters/">Santiago Paternain</a> and previously by
        <a class="link link-primary" href="https://acbull.github.io/">Ziniu Hu</a>, and expect to graduate in May 2027. I received my M.S. from the
        <a class="link link-primary" href="https://www.uchicago.edu/">University of Chicago</a>, where I worked with
        <a class="link link-primary" href="https://www.haifeng-xu.com/">Haifeng Xu</a> and <a class="link link-primary" href="https://dachxiu.chicagobooth.edu/">Dacheng Xiu</a>.
        Before that, I trained as an economist.
      </p>
      <p>
        I have also spent time in industry at
        <a class="link link-primary" href="https://www.microsoft.com/en-us/research/lab/microsoft-research-montreal/">Microsoft Research</a>,
        <a class="link link-primary" href="https://www.nec-labs.com/">NEC Laboratories America</a>, and
        <a class="link link-primary" href="https://asari.ai/">Asari.ai</a>, working on post-training coding agents and reinforcement learning for LLMs.
      </p>
      <p>
        My research has been featured in the <a class="link link-primary" href="https://www.stateof.ai/">State of AI Report</a>
        by Air Street Capital, appearing in the
        <a class="link link-primary" href="https://docs.google.com/presentation/d/1GmZmoWOa2O92BPrncRcTKa15xvQGhq7g4I4hJSNlC0M/edit#slide=id.g2d35a16f27e_0_24">2024 edition</a>.
      </p>
    </div>
  </section>

  <a class="btn btn-primary mb-4" href="mailto:jonathan.li.connect@gmail.com">Get in touch</a>

  <SelfImprovementLoop />

  <section id="news" class="mt-6 mb-12 space-y-6">
    <div class="flex items-center gap-3">
      <h2 class="text-3xl font-bold">News</h2>
      <div class="hidden sm:block h-px flex-1 bg-base-200"></div>
    </div>
    <ul class={listBaseClasses}>
      {
        recentNews.map((item) => (
          <li class={listItemWrapperClasses}>
            <span class={bulletClasses} />
            <div class={listItemContentClasses}>
              <span class="font-semibold whitespace-nowrap">{item.date}</span>
              <span set:html={item.html} />
            </div>
          </li>
        ))
      }
    </ul>
    {
      olderNews.length > 0 && (
        <details class="group">
          <summary class="cursor-pointer text-sm text-base-content/70 hover:text-base-content list-none">
            <span class="group-open:hidden">Show older news ({olderNews.length})</span>
            <span class="hidden group-open:inline">Hide older news</span>
          </summary>
          <ul class={`${listBaseClasses} mt-3`}>
            {olderNews.map((item) => (
              <li class={listItemWrapperClasses}>
                <span class={bulletClasses} />
                <div class={listItemContentClasses}>
                  <span class="font-semibold whitespace-nowrap">{item.date}</span>
                  <span set:html={item.html} />
                </div>
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </section>

  <section class="mb-12">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <h2 class="text-3xl font-bold">Selected Publications</h2>
      <a href="/publications" class="link link-primary text-sm md:text-base">View all</a>
    </div>

    {
      featuredPublications.map((publication, index) => (
        <>
          <HorizontalCard
            title={publication.title}
            subtitle={publication.subtitle}
            desc={publication.description}
            url={publication.url}
            badge={publication.badge}
            img={publication.image}
            links={publication.links}
            tags={publication.topics}
            tagHref={(topic: string) => `/publications#${topicSlug(topic)}`}
          />
          {index < featuredPublications.length - 1 && <div class="divider my-0" />}
        </>
      ))
    }
  </section>
</BaseLayout>
