---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Figures live in src/assets so Astro resizes and converts them at build time.
const figures = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/figures/*.{png,jpg,jpeg,webp}",
  { eager: true }
);

const {
  title,
  img,
  desc,
  url,
  badge,
  tags,
  target = "_blank",
  links = [],
  subtitle,
  tagHref,
} = Astro.props;

let image: ImageMetadata | undefined;
if (img && typeof img === "object") {
  image = img;
} else if (typeof img === "string") {
  const key = `/src/assets/figures/${img}`;
  image = figures[key]?.default;
  if (!image) throw new Error(`HorizontalCard: no figure at ${key}`);
}

const hasTags = Array.isArray(tags) && tags.length > 0;
const hasLinks = Array.isArray(links) && links.length > 0;
const normalizedUrl = url ?? "#";
// Optional custom tag link builder (e.g. publications topics).
const buildTagHref: (tag: string) => string =
  typeof tagHref === "function" ? tagHref : (tag) => `#${tag}`;
const baseRel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<article class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]">
  <div class="hero-content flex-col md:flex-row">
    {
      image && (
        <Image
          src={image}
          width={480}
          format="webp"
          alt={`Figure from ${title}`}
          class="max-w-full md:max-w-[13rem] h-auto rounded-lg"
        />
      )
    }
    <div class="grow w-full">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="text-xl font-bold">
          <a href={normalizedUrl} target={target} rel={baseRel} class="hover:underline">
            {title}
          </a>
        </h3>
        {badge && <div class="badge badge-secondary">{badge}</div>}
      </div>
      {subtitle && <div class="text-sm text-base-content/70 py-1">{subtitle}</div>}
      {desc && <p class="py-1" set:html={desc} />}
      {(hasTags || hasLinks) && (
        <div class="flex flex-wrap items-center gap-2 pt-2">
          {
            hasTags && (
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a href={buildTagHref(tag)} class="badge badge-outline">
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
          {
            hasLinks && (
              <div class={`flex flex-wrap gap-2 ${hasTags ? "ml-auto" : ""}`}>
                {links.map((link) => (
                  <a
                    href={link.href}
                    target={link.target ?? "_blank"}
                    rel={link.rel ?? "noopener noreferrer"}
                    class="btn btn-sm btn-outline"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      )}
    </div>
  </div>
</article>
